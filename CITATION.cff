cff-version: 1.2.0
title: "TIER: Trajectory-Invariant Execution Rewards for Multi-Step Tool Composition"
message: "If you use this work, please cite it as below."
type: software
authors:
  - given-names: Anay
    family-names: Kulkarni
    email: ankulkarni@ucsd.edu
  - given-names: ChiaEn
    family-names: Lu
    email: allenlu@ucsd.edu
  - given-names: Dheeraj
    family-names: Mekala
